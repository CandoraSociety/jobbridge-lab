{
  "name": "VisitLog",
  "type": "object",
  "properties": {
    "participant_id": {
      "type": "string"
    },
    "participant_name": {
      "type": "string"
    },
    "participant_email": {
      "type": "string"
    },
    "is_guest": {
      "type": "boolean",
      "default": false
    },
    "visit_date": {
      "type": "string",
      "format": "date-time"
    },
    "location_type": {
      "type": "string",
      "enum": [
        "onsite",
        "offsite"
      ],
      "description": "Whether the visit was from onsite (Jobs Lab) or offsite (remote)"
    }
  },
  "required": [
    "participant_name",
    "visit_date"
  ]
}