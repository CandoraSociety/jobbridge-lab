{
  "name": "JobApplication",
  "type": "object",
  "properties": {
    "participant_id": {
      "type": "string",
      "description": "ID of the participant"
    },
    "company": {
      "type": "string",
      "description": "Company name"
    },
    "position": {
      "type": "string",
      "description": "Job title/position"
    },
    "location": {
      "type": "string"
    },
    "job_url": {
      "type": "string",
      "description": "Link to the job posting"
    },
    "status": {
      "type": "string",
      "enum": [
        "saved",
        "applied",
        "phone_screen",
        "interview",
        "offer",
        "rejected",
        "withdrawn"
      ],
      "default": "saved"
    },
    "date_applied": {
      "type": "string",
      "format": "date"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "description": "Application deadline"
    },
    "salary_range": {
      "type": "string"
    },
    "how_to_apply": {
      "type": "string",
      "description": "How to apply (online, email, in-person, etc.)"
    },
    "application_instructions": {
      "type": "string",
      "description": "Specific instructions for applying (cover letter required, documents needed, etc.)"
    },
    "job_description": {
      "type": "string",
      "description": "Full job description"
    },
    "notes": {
      "type": "string"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "participant_id",
    "company",
    "position"
  ]
}