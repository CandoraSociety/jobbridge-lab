{
  "name": "Participant",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Full name of the participant"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "password_hash": {
      "type": "string",
      "description": "Simple password for returning participants"
    },
    "is_guest": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a guest session"
    },
    "total_visits": {
      "type": "number",
      "default": 1,
      "description": "Total number of visits"
    },
    "last_visit": {
      "type": "string",
      "format": "date-time",
      "description": "Last visit timestamp"
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "institution": {
            "type": "string"
          },
          "degree": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "start_year": {
            "type": "string"
          },
          "end_year": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "start_date": {
            "type": "string"
          },
          "end_date": {
            "type": "string"
          },
          "current": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "career_goals": {
      "type": "string",
      "description": "Career goals description"
    }
  },
  "required": [
    "name",
    "email"
  ]
}